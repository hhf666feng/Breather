{
  "name": "breather-windows",
  "version": "1.6.0",
  "private": true,
  "description": "Breather — a local, privacy-preserving Windows screen-break companion",
  "author": "Breather",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test.cjs",
    "check": "node scripts/check.cjs",
    "smoke": "node scripts/run-smoke.cjs",
    "build:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.breather.windows",
    "productName": "Breather",
    "asar": true,
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.cjs", "preload.cjs", "core.cjs", "contracts.cjs", "renderer/**/*", "scripts/runtime-policy.cjs", "scripts/electron-smoke.cjs", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "renderer/assets/logo.png"
    },
    "portable": {
      "artifactName": "Breather-${version}-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "Breather-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Breather",
      "deleteAppDataOnUninstall": false
    }
  }
}
